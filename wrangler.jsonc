{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fedortsov-card-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-06-08",
  "workers_dev": true,
  "preview_urls": false,
  "kv_namespaces": [
    {
      "binding": "JOBS",
      "id": "b795c4e98dc7417881b85ed2711e19b6"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    // Несколько попыток (10:30/10:50/11:20 МСК) на случай пропуска cron
    // Cloudflare; защита от дубля в runDaily не даст отправить дважды.
    "crons": ["30 7 * * *", "50 7 * * *", "20 8 * * *"]
  }
}
